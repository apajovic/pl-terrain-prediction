{
  "data": {
    "skip_preprocess": true,
    "split_channels": false,
    "input_dir": "./data/ter_unwrap",
    "target_dir": "./data/PL_unwrap_orig",
    "unwrap_dir": "./output/ter_unwrap",
    "wrap_dir": "./data/ter_wrap",
    "num_angles": 256,
    "num_radii": 256,
    "base_name": "PL"
  },
  "model": {
    "name": "transunet"
  },
  "training": {
    "batch_size": 1,
    "seed": 42,
    "device": "cuda",
    "lr": 0.0001,
    "lr_step": 130,
    "lr_gamma": 0.1,
    "epochs": 150,
    "n_trials": 10,
    "model_out": "./output/transunet_v1.pth",
    "num_workers": 4,
    "ddp": {
      "enabled": true,
      "backend": "nccl",
      "find_unused_parameters": false
    }
  },
  "evaluation": {
    "path_from_mlflow": false,
    "model_path": "./output/transunet_v1.pth"
  },
  "output": {
    "metrics_out": "./output/transunet.txt",
    "wrap_pred_dir": "./output/transunet",
    "wrap_targets_dir": "./output/targets"
  }
}
